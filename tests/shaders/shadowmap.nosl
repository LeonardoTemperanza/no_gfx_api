
Data :: struct
{
    positions: []vec4,
    normals: []vec4,
    model_to_world: mat4,
    model_to_world_normal: mat4,
    world_to_view: mat4,
    world_to_light: mat4,
    view_to_proj: mat4,
}

Vert_Output :: struct
{
    pos: vec4 @position,
    light_pos: vec4 @io(0),
    world_normal: vec4 @io(1),
}

vert :: #vertex (vert_id: uint @vert_id, data: ^Data @data) -> Vert_Output
{
    model_pos := vec4(data.positions[vert_id].xyz, 1.0);
    world_pos := data.model_to_world * model_pos;
    light_pos := data.world_to_light * world_pos;
    light_pos.y = -light_pos.y;
    view_pos := data.world_to_view * world_pos;
    clip_pos := data.view_to_proj * view_pos;
    clip_pos.y = 0.0 - clip_pos.y;

    world_normal := data.model_to_world_normal * data.normals[vert_id];

    out: Vert_Output;
    out.pos = clip_pos;
    // Seems like the normals from sponza are backwards in the z axis compared to our coords
    world_normal.z = -world_normal.z;
    out.world_normal = world_normal;
    out.light_pos = light_pos;
    return out;
}

Frag_Data :: struct
{
    shadow_texture: texture_id,
    shadow_sampler: sampler_id,
    light_dir: vec3,
}

frag :: #fragment (input: Vert_Output, data: ^Frag_Data @data) -> vec4 @io(0)
{
    light_pos := input.light_pos.xyz / input.light_pos.w;
    world_normal_vert := input.world_normal;
    normal := normalize(world_normal_vert.xyz);
    factor := dot(normal, normalize(data.light_dir));
    factor = max(0, factor);

    light_pos.xy = light_pos.xy*0.5+0.5;

    // This is the important line: Shadow maps are sampled with texture_sample_compare to use PCF
    light := texture_sample_compare(data.shadow_texture, data.shadow_sampler, light_pos);
    if (light_pos.x < 0 || light_pos.y < 0 || light_pos.x > 1 || light_pos.y > 1)
    {
        light = 0.0;
    }
    light = max(light, 0.2);
    sun_colour := vec3(1.3, 1.2, 1.0);
    ambient_colour := vec3(0.5, 0.7, 0.9);
    return vec4(
        (0.1 + factor * 0.1) * ambient_colour
        + sun_colour * factor * light * 0.8,
        1.0);
}

shadow_frag :: #fragment (input: Vert_Output)
{
}
