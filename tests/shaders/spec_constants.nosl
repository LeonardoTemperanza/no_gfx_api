
Vertex :: struct
{
    pos: vec3,
    color: vec3
}

Data :: struct
{
    verts: []Vertex,
}

Vert_Output :: struct
{
    pos: vec4 @position,
    color: vec4 @io(0),
}

spec_const_int := 4     @spec(0);
mask_out_red   := false @spec(1);
mask_out_green := true  @spec(2);
mask_out_blue  := false @spec(3);

vert :: #vertex (vert_id: uint @vert_id, data: ^Data @data) -> Vert_Output
{
    out: Vert_Output;
    out.pos = vec4(data.verts[vert_id].pos, 1.0);
    out.color = vec4(data.verts[vert_id].color, 1.0);
    return out;
}

frag :: #fragment (input: Vert_Output) -> vec4 @io(0)
{
    out := input.color;
    if mask_out_red   { out.r = 0; }
    if mask_out_green { out.g = 0; }
    if mask_out_blue  { out.b = 0; }
    if spec_const_int != 1 { out = vec4(0); }
    return out;
}
